# Development only. Replace the empty values before sourcing this file.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Explicitly opt into fictional journeys for local development only.
ME_DEMO_MODE=1
ME_SHARED_DEMO=0
PGDATABASE=skeleton
PGUSER=skeleton
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# Optional deployment settings; keep disabled for plain local HTTP.
DJANGO_HTTPS=0
DJANGO_TRUST_PROXY=0
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set PGSSLMODE=require if the database endpoint supports TLS.

# Email login is disabled until a private SMTP configuration is available.
LOGIN_EMAIL_ENABLED=0
LOGIN_EMAIL_ORIGIN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
