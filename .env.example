# Development only. Replace the empty values before sourcing this file.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PGDATABASE=skeleton
PGUSER=skeleton
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# Optional deployment settings; keep disabled for plain local HTTP.
DJANGO_HTTPS=0
DJANGO_TRUST_PROXY=0
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set PGSSLMODE=require if the database endpoint supports TLS.
