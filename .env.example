# Development only. Replace the empty values before sourcing this file.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Explicitly opt into fictional journeys for local development only.
ME_DEMO_MODE=1
ME_SHARED_DEMO=0
PGDATABASE=skeleton
PGUSER=skeleton
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# Optional deployment settings; keep disabled for plain local HTTP.
DJANGO_HTTPS=0
DJANGO_TRUST_PROXY=0
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set PGSSLMODE=require if the database endpoint supports TLS.

# Email login is disabled until a private SMTP configuration is available.
LOGIN_EMAIL_ENABLED=0
DJANGO_ENVIRONMENT=local
EMAIL_DELIVERY_ENABLED=0
# Employer text structuring works in every environment with a private key.
ALBERT_IMPORT_ENABLED=1
ALBERT_API_KEY=
ALBERT_MODEL=mistral-small-3-2-24b-instruct-2506
# Optional fictional account switcher, only on a disposable local database.
TEST_ACCOUNTS_ENABLED=0
# Public page where employers without an invitation find an EURES adviser (default: EURES portal).
# Facultatif : remplace le contact email de notre équipe pour les invitations.
ME_EMPLOYER_ADVISER_CONTACT_URL=
LOGIN_EMAIL_ORIGIN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Business features work in every environment; these defaults may be omitted.
SKILLS_PILOT_ENABLED=1
SKILLS_ALBERT_ENABLED=1
CONTINUOUS_SKILLS_ENABLED=1
MATCHING_ENABLED=1
MATCHING_TEAMS_ENABLED=1
CONFIRMATION_DIALOGUE_ENABLED=1
# Explicit test simulations only. Never inferred from the environment name.
ALBERT_IMPORT_SIMULATED=0
SKILLS_ALBERT_SIMULATED=0
CONFIRMATION_DIALOGUE_SIMULATED=0
