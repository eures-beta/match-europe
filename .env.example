# Development only. Replace the empty values before sourcing this file.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# One existing local PostgreSQL instance and role, explicit for every worktree.
# The role must have CREATEDB for Django tests. These commands never create it.
# Set a unique database name per worktree (for example match_feature_name).
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# Optional deployment settings; keep disabled for plain local HTTP.
DJANGO_HTTPS=0
DJANGO_TRUST_PROXY=0
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set PGSSLMODE=require if the database endpoint supports TLS.

# Real email delivery is disabled until explicitly configured.
DJANGO_ENVIRONMENT=local
EMAIL_DELIVERY_ENABLED=0
# Employer text structuring works in every environment with a private key.
ALBERT_API_KEY=
ALBERT_MODEL=mistral-small-3-2-24b-instruct-2506
# Optional fictional account switcher, only on a disposable local database.
DEMO_ACCOUNTS_ENABLED=0
# Shared address for team contact, candidate feedback and privacy requests.
TEAM_CONTACT_EMAIL=
LOGIN_EMAIL_ORIGIN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Explicit test simulations only. Never inferred from the environment name.
ALBERT_SIMULATED=0
