msgid "Stats"
msgstr "Statistiques"

#: eures_beta/templates/employer/privacy.html:34
#: eures_beta/templates/employer/privacy.html:183
msgctxt "employer privacy"
msgid "Project"
msgstr "Le projet"

#: eures_beta/templates/employer/privacy.html:36
#: eures_beta/templates/employer/privacy.html:184
