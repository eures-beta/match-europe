msgid "Prepared with Albert AI (DINUM) from your offer text. Check every field before saving."
msgstr "Préparation par Albert, IA de la DINUM, à partir du texte de votre offre. Vérifiez chaque champ avant enregistrement."

#: eures_beta/templates/employer/import.html:1438
msgctxt "employer albert"
msgid "Albert could not prepare this offer. The source text is preserved below; complete the fields manually or try again."
msgstr "Albert n’a pas pu préparer cette offre. Le texte source est conservé ci-dessous ; complétez les champs manuellement ou réessayez."

#: eures_beta/templates/employer/import.html:791
#: eures_beta/templates/employer/import.html:1604
msgctxt "employer albert"
