msgctxt "project page"
msgid "Hires"
msgstr "Recrutements"

#: eures_beta/templates/project.html:193
msgctxt "project page"
msgid "Time between need and introduction"
msgstr "Délai entre besoin et mise en relation"

#: eures_beta/templates/project.html:197
msgctxt "project page"
msgid "Support"
msgstr "Accompagnement"

#: eures_beta/templates/project.html:199
msgctxt "project page"
msgid "Dead-end situations identified"
msgstr "Situations d’impasse identifiées"

#: eures_beta/templates/project.html:200
msgctxt "project page"
msgid "Diagnostic reviews"
msgstr "Diagnostics"

#: eures_beta/templates/project.html:201
msgctxt "project page"
