#: eures_beta/templates/employer/import.html:1200
msgctxt "employer import"
msgid "Another question for candidates (optional)"
msgstr "Une autre question à poser aux candidats (facultatif)"

#: eures_beta/templates/employer/import.html:1122
#: eures_beta/templates/employer/import.html:1300
msgctxt "employer import"
msgid "Use of your information"
msgstr "Utilisation de vos informations"

#: eures_beta/templates/employer/import.html:1123
#: eures_beta/templates/employer/import.html:1301
msgctxt "employer import"
msgid "This information helps understand your hiring needs and prepare candidate prequalification. Authorised Match Europe teams and relevant EURES partners may access necessary information when arranging an introduction. Candidate answers are reviewed by a human."
msgstr "Ces informations servent à comprendre votre besoin de recrutement et à préparer la préqualification des candidatures. Lors d’une mise en relation, les équipes habilitées Match Europe et les partenaires EURES concernés pourront accéder aux informations nécessaires. Les réponses des candidats seront examinées par un humain."

#: eures_beta/templates/employer/import.html:1124
#: eures_beta/templates/employer/import.html:1302
msgctxt "employer import"
msgid "In this local trial, confirmation saves an inactive offer in the preparation service. It does not start candidate searches or send information to EURES partners."
msgstr "Pendant cet essai local, la validation enregistre une offre inactive dans le service de préparation. Elle ne lance ni recherche de candidats ni transmission aux partenaires EURES."

#: eures_beta/templates/employer/import.html:1125
#: eures_beta/templates/employer/import.html:1303
msgctxt "employer import"
msgid "Read the data protection notice"
msgstr "Consulter la protection des données"

#: eures_beta/templates/employer/import.html:1129
#: eures_beta/templates/employer/import.html:1201
#: eures_beta/templates/employer/import.html:1217
msgctxt "employer import"
msgid "I confirm the corrected offer information and request that it be saved. No candidate search or contact will start."
msgstr "Je confirme les informations corrigées de mon offre et demande leur enregistrement. Aucune recherche ni prise de contact avec un candidat ne sera lancée."

#: eures_beta/templates/employer/import.html:1134
#: eures_beta/templates/employer/import.html:1202
msgctxt "employer import"
msgid "Download my draft"
msgstr "Télécharger mon brouillon"

#: eures_beta/templates/employer/import.html:1134
#: eures_beta/templates/employer/import.html:1203
msgctxt "employer import"
msgid "Validate my offer"
msgstr "Valider mon offre"

#: eures_beta/templates/employer/import.html:1139
#: eures_beta/templates/employer/import.html:1207
msgctxt "employer import"
msgid "Download validated summary"
msgstr "Télécharger la fiche validée"

#: eures_beta/templates/employer/import.html:1143
#: eures_beta/templates/employer/import.html:1204
msgctxt "employer import"
msgid "Back to my email"
msgstr "Retour à mon email"

#: eures_beta/templates/employer/import.html:1148
msgctxt "employer import"
msgid "Review the extracted information and clarify the job conditions."
msgstr "Vérifiez les informations reprises et précisez les conditions du poste."

#: eures_beta/templates/employer/import.html:1149
msgctxt "employer import"
msgid "Actual the preparation service response dated 15 October 2026 for the tested Moovijob offer. Location is approximate and must be confirmed. the preparation service did not generate the questions below."
msgstr "Retour réel de la sandbox le service de préparation du 15 octobre 2026, pour l’offre Moovijob testée. La localisation est approximative et doit être confirmée. le service de préparation n’a pas produit les questions ci-dessous."

#: eures_beta/templates/employer/import.html:1150
msgctxt "employer import"
msgid "Automatic reading of this source is not connected. Complete the form below; no information has been invented from your file or link."
msgstr "La lecture automatique de cette source n’est pas raccordée. Complétez la fiche ci-dessous ; aucune information n’a été inventée à partir de votre fichier ou de votre lien."

#: eures_beta/templates/employer/import.html:1190
msgctxt "employer import"
msgid "Question"
msgstr "Question"

#: eures_beta/templates/employer/import.html:1194
msgctxt "employer import"
msgid "What experience do you have in brasserie cooking?"
msgstr "Quelle expérience avez-vous en cuisine de brasserie ?"

#: eures_beta/templates/employer/import.html:1195
msgctxt "employer import"
msgid "Which preparations can you handle: starters, hot dishes, meat cooking and sauces?"
msgstr "Quelles préparations maîtrisez-vous : entrées, plats chauds, cuissons des viandes et sauces ?"

#: eures_beta/templates/employer/import.html:1196
msgctxt "employer import"
msgid "Can you work split shifts? Describe any constraints."
msgstr "Pouvez-vous travailler en horaires coupés ? Précisez vos contraintes éventuelles."

#: eures_beta/templates/employer/import.html:1197
msgctxt "employer import"
msgid "When could you start?"
msgstr "À partir de quand seriez-vous disponible ?"

#: eures_beta/templates/employer/import.html:1198
msgctxt "employer import"
msgid "How could you reach the workplace at the required times?"
msgstr "Comment pourriez-vous rejoindre le lieu de travail aux horaires prévus ?"

#: eures_beta/templates/employer/import.html:1205
msgctxt "employer import"
msgid "Draft downloaded as JSON. Keep the file on your computer: nothing is saved on the server."
msgstr "Brouillon téléchargé en JSON. Conservez ce fichier sur votre ordinateur : rien n’est enregistré sur le serveur."

#: eures_beta/templates/employer/import.html:1206
msgctxt "employer import"
msgid "Offer validated in this demonstration. You can download the validated summary. No the preparation service update, search or candidate contact has occurred."
msgstr "Offre validée dans cette démonstration. Vous pouvez télécharger la fiche validée. Aucun nouvel envoi au service de préparation, aucune recherche et aucun contact candidat n’ont eu lieu."

#: eures_beta/templates/employer/import.html:1208
msgctxt "employer import"
msgid "The offer has changed: review and confirm again before validating."
msgstr "La fiche a été modifiée : vérifiez et confirmez à nouveau avant validation."

#: eures_beta/templates/employer/import.html:1209
msgctxt "employer import"
msgid "Complete job title, company, location, description and contract type, then confirm. Every selected question must contain text."
msgstr "Complétez le poste, l’entreprise, le lieu, la description et le type de contrat, puis confirmez la fiche. Chaque question retenue doit contenir un texte."

#: eures_beta/templates/employer/import.html:1211
msgctxt "employer import"
msgid "Save my draft"
msgstr "Enregistrer mon brouillon"

#: eures_beta/templates/employer/import.html:1212
msgctxt "employer import"
msgid "Draft saved in PostgreSQL on this computer. Resume it from this browser."
msgstr "Brouillon enregistré dans PostgreSQL sur cet ordinateur. Vous pouvez le reprendre depuis ce navigateur."

#: eures_beta/templates/employer/import.html:1213
msgctxt "employer import"
msgid "Confirm my offer"
msgstr "Valider mon offre"

#: eures_beta/templates/employer/import.html:1214
msgctxt "employer import"
msgid "Your offer has been saved."
msgstr "Votre offre est enregistrée."

#: eures_beta/templates/employer/import.html:1215
msgctxt "employer import"
msgid "AI-assisted offer summary. Review all information and clarify missing details."
msgstr "Fiche préparée avec une assistance par intelligence artificielle. Vérifiez les informations et complétez les points à clarifier."

#: eures_beta/templates/employer/import.html:1216
msgctxt "employer import"
msgid "An initial inactive offer has been sent to the preparation service. Corrections stay local until you validate the update. Your email is not sent to the preparation service."
msgstr "L’IA peut produire des erreurs ou omettre des informations. Vous pouvez corriger cette fiche avant de la valider. Votre email n’est pas transmis au prestataire de préparation."

#: eures_beta/templates/employer/import.html:1218
msgctxt "employer import"
msgid "Check on OpenStreetMap"
msgstr "Vérifier sur OpenStreetMap"

#: eures_beta/templates/employer/import.html:1219
msgctxt "employer import"
msgid "I checked the proposed point and confirm it matches the workplace."
msgstr "J’ai vérifié le point proposé et confirme qu’il correspond au lieu de travail."

#: eures_beta/templates/employer/import.html:1220
msgctxt "employer import"
msgid "View the location on OpenStreetMap"
msgstr "Voir le lieu sur OpenStreetMap"

#: eures_beta/templates/employer/import.html:1221
msgctxt "employer import"
msgid "Unsure about the location? Check it on the map. This is optional."
msgstr "Un doute sur le lieu ? Consultez la carte pour vérifier. C’est facultatif."

#: eures_beta/templates/employer/import.html:1222
msgctxt "employer import"
msgid "Saving and reading back from the preparation service…"
msgstr "Enregistrement de votre offre…"

#: eures_beta/templates/employer/import.html:1223
msgctxt "employer import"
msgid "Saving draft…"
msgstr "Enregistrement du brouillon…"

#: eures_beta/templates/employer/import.html:1225
msgctxt "employer import"
msgid "What experience do you have for this job?"
msgstr "Quelle expérience avez-vous pour ce poste ?"

#: eures_beta/templates/employer/import.html:1226
msgctxt "employer import"
msgid "Which required skills do you have?"
msgstr "Quelles compétences du poste maîtrisez-vous ?"

#: eures_beta/templates/employer/import.html:1227
msgctxt "employer import"
msgid "What are your availability and working-hour constraints?"
msgstr "Quelles sont vos disponibilités et contraintes horaires ?"

#: eures_beta/templates/employer/import.html:1228
msgctxt "employer import variant"
msgid "When could you start?"
msgstr "À partir de quand pourriez-vous commencer ?"

#: eures_beta/templates/employer/import.html:1229
msgctxt "employer import"
msgid "Can you reach the workplace at the required times?"
msgstr "Pouvez-vous rejoindre le lieu de travail aux horaires prévus ?"

#: eures_beta/templates/employer/import.html:1232
msgctxt "employer import"
msgid "Complete and save the company contact before validating the offer."
msgstr "Renseignez et enregistrez le contact entreprise avant de valider l’offre."

#: eures_beta/templates/employer/import.html:1233
msgctxt "employer import"
msgid "Sandbox did not confirm complete storage. Corrections are saved; retry."
msgstr "La sandbox n’a pas confirmé l’enregistrement complet. Vos corrections restent sauvegardées ; réessayez."

#: eures_beta/templates/employer/import.html:1234
msgctxt "employer import"
msgid "Sandbox key is missing from the local server."
msgstr "La clé sandbox n’est pas configurée sur le serveur local."

#: eures_beta/templates/employer/import.html:1235
msgctxt "employer import"
msgid "Location not found. Specify city, country and street if possible."
msgstr "Lieu non trouvé. Précisez la ville, le pays et si possible l’adresse."

#: eures_beta/templates/employer/import.html:1236
msgctxt "employer import"
msgid "Check the map point and confirm the workplace."
msgstr "Vérifiez le point sur la carte puis confirmez le lieu."

#: eures_beta/templates/employer/import.html:1237
msgctxt "employer import"
msgid "Complete essential fields and confirm."
msgstr "Complétez les champs essentiels et confirmez la fiche."

#: eures_beta/templates/employer/import.html:1238
msgctxt "employer import"
msgid "Draft changed in another tab. Reload it first."
msgstr "Le brouillon a changé dans un autre onglet. Rechargez-le avant de continuer."

#: eures_beta/templates/employer/import.html:1239
msgctxt "employer import"
msgid "Check fields, questions and lengths."
msgstr "Vérifiez les champs, les questions et leurs longueurs."

#: eures_beta/templates/employer/import.html:1240
msgctxt "employer import"
msgid "Local server unavailable. Entries remain on screen."
msgstr "Le serveur local est indisponible. Votre saisie reste à l’écran."

#: eures_beta/templates/employer/import.html:1241
msgctxt "employer import"
msgid "the preparation service requires a job title, company, location and description. Complete missing fields to send an initial inactive version. You will then review its response and questions."
msgstr "le service de préparation exige le poste, l’entreprise, le lieu et une description. Complétez les informations manquantes pour envoyer une première version inactive. Vous vérifierez ensuite le retour et les questions."

#: eures_beta/templates/employer/import.html:1242
#: eures_beta/templates/employer/import.html:1488
msgctxt "employer import"
msgid "Local test: external services are disabled. You can save the draft."
msgstr "Essai local : les services externes sont désactivés. Vous pouvez enregistrer le brouillon."

#: eures_beta/templates/employer/import.html:1245
msgctxt "employer import"
msgid "Some information before sending to the preparation service"
msgstr "Complétez les informations nécessaires"

#: eures_beta/templates/employer/import.html:1246
msgctxt "employer import variant"
msgid "the preparation service requires a job title, company, location and description. Complete missing fields to send an initial inactive version. You will then review its response and questions."
msgstr "Le poste, l’entreprise, le lieu et une description sont nécessaires pour préparer votre fiche avec une assistance par IA. Vous pourrez ensuite vérifier et corriger le résultat."

#: eures_beta/templates/employer/import.html:1247
msgctxt "employer import"
msgid "Send to the preparation service and retrieve the offer"
msgstr "Préparer ma fiche"

#: eures_beta/templates/employer/import.html:1250
msgctxt "employer import"
msgid "Edit"
msgstr "Modifier"

#: eures_beta/templates/employer/import.html:1297
#, python-brace-format
msgctxt "employer import"
msgid "The role involves: {items}. Can you work under these conditions?"
msgstr "Le poste prévoit les conditions suivantes : {items}. Pouvez-vous travailler dans ces conditions ?"

#: eures_beta/templates/employer/import.html:1298
#, python-brace-format
msgctxt "employer import"
msgid "Do you hold these licences or authorisations: {items}?"
msgstr "Disposez-vous des permis ou autorisations suivants : {items} ?"

#: eures_beta/templates/employer/import.html:1299
msgctxt "employer import"
msgid "When could you start and, if needed, relocate near the workplace?"
msgstr "À partir de quand pourriez-vous commencer et, si nécessaire, vous installer près du lieu de travail ?"

#: eures_beta/templates/employer/import.html:1315
#: eures_beta/templates/employer/import.html:1373
msgctxt "employer import"
msgid "Your offer has been saved"
msgstr "Votre offre est enregistrée"

#: eures_beta/templates/employer/import.html:1316
#: eures_beta/templates/employer/import.html:1374
msgctxt "employer import"
msgid "You have completed this step. You can review the saved information below."
msgstr "Vous avez terminé cette étape. Vous pouvez consulter les informations enregistrées ci-dessous."

#: eures_beta/templates/employer/import.html:1317
#: eures_beta/templates/employer/import.html:1375
msgctxt "employer import"
msgid "What happens next?"
msgstr "Et ensuite ?"

#: eures_beta/templates/employer/import.html:1319
#: eures_beta/templates/employer/import.html:1377
msgctxt "employer import"
msgid "Your offer is saved with the job conditions and arrival support you specified."
msgstr "Votre offre est conservée avec les conditions du poste et les aides à l’arrivée que vous avez indiquées."

#: eures_beta/templates/employer/import.html:1320
#: eures_beta/templates/employer/import.html:1378
msgctxt "employer import"
msgid "The next step in the journey will be candidate prequalification: availability, skills and job requirements."
msgstr "La prochaine étape du parcours sera la préqualification des candidatures : disponibilité, compétences et exigences du poste."

#: eures_beta/templates/employer/import.html:1321
#: eures_beta/templates/employer/import.html:1379
msgctxt "employer import"
msgid "An introduction will then require agreement from you and the candidate, with support from an adviser."
msgstr "La mise en relation nécessitera ensuite votre accord et celui du candidat, avec l’accompagnement d’un conseiller."

#: eures_beta/templates/employer/import.html:1323
#: eures_beta/templates/employer/import.html:1381
msgctxt "employer import"
msgid "This local trial stops here: no candidate search, prequalification or contact is started. No confirmation email is sent."
msgstr "Cet essai local s’arrête ici : aucune recherche de candidats, aucune préqualification ni prise de contact n’est lancée. Aucun email de confirmation n’est envoyé."

#: eures_beta/templates/employer/import.html:1324
#: eures_beta/templates/employer/import.html:1383
msgctxt "employer import"
msgid "View my offer"
msgstr "Voir mon offre"

#: eures_beta/templates/employer/import.html:1325
#: eures_beta/templates/employer/import.html:1393
msgctxt "employer import"
msgid "Add another offer"
msgstr "Ajouter une autre offre"

#: eures_beta/templates/employer/import.html:1326
#: eures_beta/templates/employer/import.html:1390
msgctxt "employer import"
msgid "Back to the employer home"
msgstr "Revenir à l’accueil employeur"

#: eures_beta/templates/employer/import.html:1328
msgctxt "employer import"
msgid "Offer extracted from your document. Check and complete the information."
msgstr "Fiche extraite de votre document. Vérifiez et complétez les informations."

#: eures_beta/templates/employer/import.html:1329
msgctxt "employer import"
msgid "Local reading using text extraction, without generative AI or transfer to a provider. The result may contain errors."
msgstr "Lecture locale par extraction de texte, sans IA générative ni transmission à un prestataire. Le résultat peut contenir des erreurs."

#: eures_beta/templates/employer/import.html:1331
msgctxt "employer import"
msgid "During this trial, the draft is saved only in the local database. No publication, candidate search or transfer to EURES partners."
msgstr "Pendant cet essai, le brouillon est enregistré uniquement dans la base locale. Aucune publication, recherche de candidats ou transmission aux partenaires EURES."

#: eures_beta/templates/employer/import.html:1332
msgctxt "employer import"
msgid "Your offer has been saved locally."
msgstr "Votre offre a été enregistrée localement."

#: eures_beta/templates/employer/import.html:1334
msgctxt "employer import"
msgid "Document information to check"
msgstr "Informations à vérifier dans le document"

#: eures_beta/templates/employer/import.html:1335
msgctxt "employer import"
msgid "Conflicting hours — please confirm"
msgstr "Horaires contradictoires — à confirmer"

#: eures_beta/templates/employer/import.html:1336
msgctxt "employer import"
msgid "Multiple contract types — please confirm"
msgstr "Plusieurs types de contrat — à confirmer"

#: eures_beta/templates/employer/import.html:1337
msgctxt "employer import"
msgid "Clarify location or remote work conditions"
msgstr "Lieu ou conditions de télétravail à préciser"

#: eures_beta/templates/employer/import.html:1338
msgctxt "employer import"
msgid "Text recognized from an image: check for recognition errors"
msgstr "Texte reconnu dans une image : vérifiez les erreurs éventuelles"

#: eures_beta/templates/employer/import.html:1339
msgctxt "employer import"
msgid "Please confirm this information"
msgstr "Information à confirmer"

#: eures_beta/templates/employer/import.html:1397
#: eures_beta/templates/employer/import.html:1433
msgctxt "employer import"
msgid "Next step: review your offer"
msgstr "La prochaine étape : vérifier votre offre"

#: eures_beta/templates/employer/import.html:1398
#: eures_beta/templates/employer/import.html:1434
msgctxt "employer import"
msgid "PDF, link or manual entry and the email step can be tested. Reading documents and web pages is not connected yet. No offer or email has been sent or saved, and no job website has been contacted."
msgstr "Le choix du PDF, du lien ou de la saisie manuelle et l’étape email sont testables. La lecture des documents et des pages web n’est pas encore raccordée. Aucune offre ni aucun email n’a été transmis ou enregistré ; aucun site d’offre n’a été contacté."

#: eures_beta/templates/employer/import.html:1401
#: eures_beta/templates/employer/import.html:1435
msgctxt "employer import"
msgid "Start again"
msgstr "Recommencer"

#: eures_beta/templates/employer/import.html:1407
msgctxt "employer import"
msgid "Match Europe · A France Travail / EURES / ADEM / Le Forem / ELA experiment"
msgstr "Match Europe · Une expérimentation France Travail / EURES / ADEM / Le Forem / ELA"

#: eures_beta/templates/employer/import.html:1408
msgctxt "employer import"
msgid "Useful links"
msgstr "Liens utiles"

#: eures_beta/templates/employer/import.html:1417
msgctxt "employer import"
msgid "Add your job offer"
msgstr "Ajoutez votre offre d’emploi"

#: eures_beta/templates/employer/import.html:1418
msgctxt "employer import"
msgid "Import a PDF, paste a link to a public job offer or enter your offer manually. We will prepare a summary for you to check and complete."
msgstr "Importez un PDF, collez le lien d’une offre publique ou renseignez votre offre manuellement. Nous préparerons une fiche que vous pourrez vérifier et compléter."

#: eures_beta/templates/employer/import.html:1424
msgctxt "employer import"
msgid "I prefer to enter my offer manually"
msgstr "Je préfère renseigner mon offre manuellement"

#: eures_beta/templates/employer/import.html:1437
#: eures_beta/templates/employer/import.html:1478
msgctxt "employer import"
msgid "Choose one PDF or PNG/JPEG images of the same job."
msgstr "Choisissez un PDF seul ou des images PNG/JPEG d’une même offre."

#: eures_beta/templates/employer/import.html:1438
#: eures_beta/templates/employer/import.html:1479
msgctxt "employer import"
msgid "Limit: 8 images and 10 MB total, or one 10 MB PDF."
msgstr "Limite : 8 images et 10 Mo au total, ou un PDF de 10 Mo."

#: eures_beta/templates/employer/import.html:1439
msgctxt "employer import"
msgid "Choose a PDF or images to continue."
msgstr "Choisissez un PDF ou des images pour continuer."

#: eures_beta/templates/employer/import.html:1440
#: eures_beta/templates/employer/import.html:1477
msgctxt "employer import"
msgid "Unreadable, protected or excessive document, or local OCR unavailable. Try another file or paste the text."
msgstr "Document illisible, protégé ou trop long, ou OCR local indisponible. Essayez un autre fichier ou collez le texte."

#: eures_beta/templates/employer/import.html:1441
msgctxt "employer import"
msgid "Enter your offer text to continue."
msgstr "Renseignez le texte de votre offre pour continuer."

#: eures_beta/templates/employer/import.html:1443
msgctxt "employer import"
msgid "Your offer"
msgstr "Votre offre"

#: eures_beta/templates/employer/import.html:1444
msgctxt "employer import"
msgid "Review"
msgstr "Vérification"

#: eures_beta/templates/employer/import.html:1445
msgctxt "employer import"
msgid "Save"
msgstr "Enregistrement"

#: eures_beta/templates/employer/import.html:1447
msgctxt "employer import"
msgid "Selected file: "
msgstr "Fichier sélectionné : "

#: eures_beta/templates/employer/import.html:1449
msgctxt "employer import"
msgid "Your agreement to prepare the offer"
msgstr "Votre accord pour préparer l’offre"

#: eures_beta/templates/employer/import.html:1450
msgctxt "employer import"
msgid "I request AI-assisted preparation of my offer. Offer information is sent to a technical service provider to prepare a summary for my review. My email is not sent to that provider."
msgstr "Je demande la préparation de mon offre avec une assistance par intelligence artificielle. Les informations de l’offre sont transmises à un prestataire technique pour préparer la fiche que je vérifierai. Mon email ne lui est pas transmis."

#: eures_beta/templates/employer/import.html:1451
msgctxt "employer import"
msgid "Artificial intelligence helps structure your offer and identify information to clarify. It can make mistakes: you will review and correct the summary before confirming it."
msgstr "Une intelligence artificielle aide à structurer votre offre et à repérer les informations à préciser. Elle peut produire des erreurs : vous vérifierez et corrigerez la fiche avant de la valider."

#: eures_beta/templates/employer/import.html:1452
msgctxt "employer import"
msgid "In this demonstration, agreement is simulated and is not recorded. The legal basis and final wording remain to be confirmed with France Travail."
msgstr "Dans cette démonstration, cet accord est simulé et n’est pas enregistré. La base juridique et le texte définitif restent à confirmer avec France Travail."

#: eures_beta/templates/employer/import.html:1453
msgctxt "employer import"
msgid "Use a job offer link"
msgstr "Utiliser le lien d’une offre"

#: eures_beta/templates/employer/import.html:1457
msgctxt "employer import"
msgid "Enter an HTTPS link to a public website, without credentials or a local address."
msgstr "Indiquez un lien HTTPS vers un site public, sans identifiants ni adresse locale."

#: eures_beta/templates/employer/import.html:1467
msgctxt "employer import"
msgid "Local trial: documents read without an external service. No publication or candidate search."
msgstr "Essai local : lecture des documents sans service externe. Aucune publication ni recherche de candidats."

#: eures_beta/templates/employer/import.html:1468
msgctxt "employer import"
msgid "Your email is saved in your local draft. No sign-in email is sent during this trial."
msgstr "Votre email est conservé dans votre brouillon local. Aucun email de connexion n’est envoyé pendant cet essai."

#: eures_beta/templates/employer/import.html:1469
msgctxt "employer import"
msgid "No application is assessed or rejected at this step."
msgstr "Aucune candidature n’est évaluée ou écartée à cette étape."

#: eures_beta/templates/employer/import.html:1470
msgctxt "employer import"
msgid "The page will be checked before we ask for your email."
msgstr "La page sera vérifiée avant de vous demander votre email."

#: eures_beta/templates/employer/import.html:1471
msgctxt "employer import"
msgid "Reading and preparing your offer…"
msgstr "Lecture et préparation de votre offre…"

#: eures_beta/templates/employer/import.html:1472
msgctxt "employer import"
msgid "Resume a draft in this browser"
msgstr "Reprendre un brouillon sur ce navigateur"

#: eures_beta/templates/employer/import.html:1473
msgctxt "employer import"
msgid "Unable to continue: "
msgstr "Impossible de continuer : "

#: eures_beta/templates/employer/import.html:1475
msgctxt "employer import"
msgid "Use a public HTTPS page without credentials or internal addresses."
msgstr "Le lien doit viser une page HTTPS publique, sans identifiants ni adresse interne."

#: eures_beta/templates/employer/import.html:1476
msgctxt "employer import"
msgid "The site is unavailable or does not allow this page to be read automatically."
msgstr "Le site est inaccessible ou ne permet pas la lecture automatique de cette page."

#: eures_beta/templates/employer/import.html:1480
msgctxt "employer import"
msgid "Confirm agreement to prepare the offer."
msgstr "Confirmez votre accord pour préparer l’offre."

#: eures_beta/templates/employer/import.html:1481
msgctxt "employer import"
msgid "Check your email."
msgstr "Vérifiez votre email."

#: eures_beta/templates/employer/import.html:1482
msgctxt "employer import"
msgid "Check the fields and text length."
msgstr "Vérifiez les champs et la longueur du texte."

#: eures_beta/templates/employer/import.html:1483
msgctxt "employer import"
msgid "This session has reached 30 drafts."
msgstr "La limite de 30 brouillons de cette session est atteinte."

#: eures_beta/templates/employer/import.html:1484
msgctxt "employer import"
msgid "This draft is unavailable in this session."
msgstr "Ce brouillon n’est pas accessible depuis cette session."

#: eures_beta/templates/employer/import.html:1485
msgctxt "employer import"
msgid "The local server is unavailable. Your entries remain on screen."
msgstr "Le serveur local est indisponible. Votre saisie reste à l’écran."

#: eures_beta/templates/employer/import.html:1486
msgctxt "employer import"
msgid "This link opens a list of offers. Open the individual advert on France Travail and copy its specific link."
msgstr "Ce lien mène à une liste d’offres. Ouvrez l’annonce souhaitée sur France Travail, puis copiez le lien de cette annonce précise."

#: eures_beta/templates/employer/import.html:1487
msgctxt "employer import"
msgid "Check the company contact name and email."
msgstr "Vérifiez le nom et l’email du contact entreprise."

#: eures_beta/templates/employer/import.html:1491
msgctxt "employer import"
msgid "Read this offer"
msgstr "Lire cette offre"

#: eures_beta/templates/employer/import.html:1493
msgctxt "employer import"
msgid "Reading the link…"
msgstr "Lecture du lien en cours…"

#: eures_beta/templates/employer/import.html:1494
msgctxt "employer import"
msgid "We cannot read this offer"
msgstr "Nous ne pouvons pas lire cette offre"

#: eures_beta/templates/employer/import.html:1495
msgctxt "employer import"
msgid "Choose another method: import a PDF or paste the offer text."
msgstr "Choisissez une autre méthode : importer un PDF ou copier-coller le texte de l’annonce."

#: eures_beta/templates/employer/import.html:1496
msgctxt "employer import"
msgid "Read documents"
msgstr "Lire les documents"

#: eures_beta/templates/employer/import.html:1497
msgctxt "employer import"
msgid "Reading documents…"
msgstr "Lecture des documents en cours…"

#: eures_beta/templates/employer/import.html:1498
msgctxt "employer import"
msgid "By clicking “Read documents”, you request preparation of your offer. The result may contain errors: check and correct it before validation. This trial uses local text extraction, without generative AI or transfer to a provider. No publication or candidate search will be started."
msgstr "En cliquant sur « Lire les documents », vous demandez la préparation de votre offre. Le résultat peut contenir des erreurs : vérifiez et corrigez les informations avant validation. Pendant cet essai, la lecture utilise une extraction locale, sans IA générative ni transmission à un prestataire. Aucune publication ni recherche de candidats ne sera lancée."

#: eures_beta/templates/employer/import.html:1499
msgctxt "employer import"
msgid "Choose a PDF or images"
msgstr "Choisir un PDF ou des images"

#: eures_beta/templates/employer/import.html:1500
msgctxt "employer import"
msgid "One PDF or up to 8 PNG/JPEG images of the same job, in reading order · 10 MB total. Local reading of images and scanned pages."
msgstr "Un PDF ou jusqu’à 8 images PNG/JPEG d’une même offre, dans l’ordre de lecture · 10 Mo au total. Lecture locale des images et des pages scannées."

#: eures_beta/templates/employer/import.html:1501
msgctxt "employer import"
msgid "Import a PDF or images"
msgstr "Importer un PDF ou des images"

#: eures_beta/templates/employer/import.html:1502
msgctxt "employer import"
msgid "Your job is in a document or screenshots."
msgstr "Votre offre est dans un document ou des captures d’écran."

#: eures_beta/templates/employer/import.html:1509
msgctxt "employer import"
msgid "Your contact for the adviser"
msgstr "Votre contact pour le conseiller"

#: eures_beta/templates/employer/import.html:1510
msgctxt "employer import"
msgid "Full name"
msgstr "Nom et prénom"

#: eures_beta/templates/employer/import.html:1511
msgctxt "employer import"
msgid "Contact email"
msgstr "Email du contact"

#: eures_beta/templates/employer/import.html:1512
msgctxt "employer import"
msgid "Phone (optional)"
msgstr "Téléphone (facultatif)"

#: eures_beta/templates/employer/import.html:1513
msgctxt "employer import"
msgid "Role in the company (optional)"
msgstr "Fonction dans l’entreprise (facultatif)"

#: eures_beta/templates/employer/import.html:1514
msgctxt "employer import"
msgid "These contact details can be viewed by the adviser responsible for your offer and administrators. They are not shown to candidates or added to the offer data sent to AGLAE."
msgstr "Ces coordonnées sont consultables par le conseiller chargé de votre offre et les administrateurs. Elles ne sont pas affichées aux candidats ni ajoutées aux données de l’offre transmises à AGLAE."

#: eures_beta/templates/employer/import.html:1515
msgctxt "employer import"
msgid "Save contact"
msgstr "Enregistrer le contact"

#: eures_beta/templates/employer/import.html:1516
msgctxt "employer import"
msgid "Contact saved."
msgstr "Contact enregistré."

#: eures_beta/templates/employer/import.html:1517
msgctxt "employer import"
msgid "Unable to save the contact. Check the fields."
msgstr "Impossible d’enregistrer le contact. Vérifiez les champs."

#: eures_beta/templates/employer/import.html:1518
msgctxt "employer import"
msgid "The draft has changed. Reload it before editing the contact."
msgstr "Le brouillon a changé. Rechargez-le avant de modifier le contact."

#: eures_beta/templates/employer/import.html:1519
msgctxt "employer import"
msgid "The contact may be different from the person accessing this workspace."
msgstr "Le contact peut être différent de la personne qui accède à cet espace."

