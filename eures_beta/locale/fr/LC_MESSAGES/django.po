#: eures_beta/templates/employer/import.html:1295
msgctxt "employer import"
msgid "Suggest questions from my answers"
msgstr "Proposer des questions à partir de mes réponses"

#: eures_beta/templates/employer/import.html:1041
#: eures_beta/templates/employer/import.html:1296
msgctxt "employer import"
msgid "Suggested questions are not automatically enabled. Review, adapt and select those to ask. Previously edited questions are kept."
msgstr "Les questions proposées ne sont pas activées automatiquement. Relisez-les, adaptez-les et cochez celles à poser. Les questions déjà modifiées sont conservées."

#: eures_beta/templates/employer/import.html:1042
#: eures_beta/templates/employer/import.html:1189
msgctxt "employer import"
msgid "Choose and adapt questions to help pursue or reject applications against job requirements. Interested candidates answer before an introduction. No automatic exclusion: a human reviews the answers."
msgstr "Choisissez et adaptez les questions qui aideront à poursuivre ou écarter une candidature selon les exigences du poste. Les candidats intéressés y répondront avant la mise en relation. Aucune exclusion automatique : les réponses seront examinées par un humain."

#: eures_beta/templates/employer/import.html:1044
#: eures_beta/templates/employer/import.html:1050
msgctxt "employer import"
msgid "Question 1"
msgstr "Question 1"

#: eures_beta/templates/employer/import.html:1047
