msgid "I’m an employer"
msgstr "Je suis employeur"

#: eures_beta/templates/employer/landing.html:281
msgctxt "public positioning"
msgid "Upload your job offer as a PDF, add a link to your advert or enter your recruitment needs."
msgstr "Importez votre offre en PDF, ajoutez le lien de votre annonce ou saisissez votre besoin."

