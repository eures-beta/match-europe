msgstr "Die Fernnachricht wurde von Chrome empfangen und die Anzeige vom System akzeptiert."

#: eures_beta/journeys/push_strings.py:44
msgctxt "push diagnostic"
msgid "Remote message received by Chrome, attempting to display…"
msgstr "Die Fernnachricht wurde von Chrome empfangen. Anzeige wird versucht…"

#: eures_beta/journeys/push_strings.py:46
msgctxt "push diagnostic"
msgid "Browser error: "
msgstr "Browserfehler: "

#: eures_beta/journeys/push_strings.py:49
msgctxt "push diagnostic"
msgid "Web Push is unavailable here. Open this address in Chrome outside private browsing."
