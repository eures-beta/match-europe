msgctxt "employer import"
msgid "Read the data protection notice"
msgstr "Datenschutzhinweise lesen"

#: eures_beta/templates/employer/import.html:1223
#: eures_beta/templates/employer/import.html:1299
#: eures_beta/templates/employer/import.html:1315
