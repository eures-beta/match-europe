msgid "Not required"
msgstr "Nicht erforderlich"

#: eures_beta/templates/employer/language_strings.html:7
msgctxt "employer languages"
msgid "A1 — Understand and use very simple words and phrases"
msgstr "A1 — Sehr einfache Wörter und Sätze verstehen und verwenden"

#: eures_beta/templates/employer/language_strings.html:8
