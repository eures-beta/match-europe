#: eures_beta/journeys/push_strings.py:9
msgctxt "push diagnostic"
msgid "The server could not complete this step."
msgstr "Der Server konnte diesen Schritt nicht abschließen."

#: eures_beta/journeys/push_strings.py:13
msgctxt "push diagnostic"
msgid "Permission was not granted. You can change it in Chrome's site settings."
msgstr "Die Berechtigung wurde nicht erteilt. Sie können sie in den Website-Einstellungen von Chrome ändern."

#: eures_beta/journeys/push_strings.py:17
msgctxt "push diagnostic"
msgid "Notifications allowed and subscription saved. You can schedule the test."
msgstr "Benachrichtigungen sind erlaubt und das Abonnement wurde gespeichert. Sie können den Test planen."

#: eures_beta/journeys/push_strings.py:21
msgctxt "push diagnostic"
msgid "Scheduled in 10 seconds. Close this tab while keeping Chrome open. Click the notification to return here."
msgstr "Versand in 10 Sekunden geplant. Schließen Sie diesen Tab und lassen Sie Chrome geöffnet. Klicken Sie auf die Benachrichtigung, um zurückzukehren."

#: eures_beta/journeys/push_strings.py:25
msgctxt "push diagnostic"
msgid "Test stopped and subscription removed. Chrome's permission can be removed in its settings."
msgstr "Der Test wurde beendet und das Abonnement entfernt. Die Chrome-Berechtigung können Sie in den Einstellungen zurücknehmen."

#: eures_beta/journeys/push_strings.py:27
msgctxt "push diagnostic"
msgid "Creating a new alert…"
msgstr "Eine neue Benachrichtigung wird erstellt…"

#: eures_beta/journeys/push_strings.py:28
msgctxt "push diagnostic"
msgid "Match Europe — local display"
msgstr "Match Europe — lokale Anzeige"

#: eures_beta/journeys/push_strings.py:31
msgctxt "push diagnostic"
msgid "This alert is created directly on your Mac, without remote delivery."
msgstr "Diese Benachrichtigung wird direkt auf Ihrem Mac ohne Fernversand erstellt."

#: eures_beta/journeys/push_strings.py:35
#, python-brace-format
msgctxt "push diagnostic"
msgid "Chrome accepted the local display. Active notifications: {count}. If no alert is visible, check Chrome/macOS display settings."
msgstr "Chrome hat die lokale Anzeige akzeptiert. Aktive Benachrichtigungen: {count}. Wenn keine Meldung sichtbar ist, prüfen Sie die Anzeigeeinstellungen von Chrome/macOS."

