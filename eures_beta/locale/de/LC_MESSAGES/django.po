msgid "Existing notice dated 3 August 2026 — needs updating for the offer import journey. Local copy, not validated for this new journey."
msgstr "Bestehender Hinweis vom 3. August 2026 — für den Angebotsimport zu aktualisieren. Lokale Kopie, für diesen neuen Ablauf nicht bestätigt."

#: eures_beta/templates/employer/privacy.html:18
msgctxt "employer privacy"
msgid "EURES beta - cross-border mobility, matching and follow-up"
msgstr "EURES beta - grenzüberschreitende Mobilität, Matching und Begleitung"

#: eures_beta/templates/employer/privacy.html:23
