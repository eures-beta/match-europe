#: eures_beta/templates/employer/condition_strings.html:10
msgctxt "employer conditions"
msgid "Currency"
msgstr "Währung"

#: eures_beta/templates/employer/condition_strings.html:11
msgctxt "employer conditions"
msgid "Gross or net"
msgstr "Brutto oder netto"

#: eures_beta/templates/employer/condition_strings.html:12
msgctxt "employer conditions"
