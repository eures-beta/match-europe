msgctxt "employer languages"
msgid "Which languages are needed for this role?"
msgstr "Welche Sprachen werden für diese Stelle benötigt?"

#: eures_beta/templates/employer/language_strings.html:4
msgctxt "employer languages"
msgid "Select the minimum level needed for each language. The descriptions are practical guidance, not a language assessment."
msgstr "Wählen Sie das erforderliche Mindestniveau je Sprache. Die Beschreibungen dienen zur Orientierung, nicht als Sprachtest."

#: eures_beta/templates/employer/language_strings.html:5
msgctxt "employer languages"
msgid "Select a level"
msgstr "Niveau auswählen"

#: eures_beta/templates/employer/language_strings.html:6
msgctxt "employer languages"
msgid "Not required"
msgstr "Nicht erforderlich"

#: eures_beta/templates/employer/language_strings.html:7
msgctxt "employer languages"
msgid "A1 — Understand and use very simple words and phrases"
msgstr "A1 — Sehr einfache Wörter und Sätze verstehen und verwenden"

#: eures_beta/templates/employer/language_strings.html:8
msgctxt "employer languages"
msgid "A2 — Communicate about simple, routine tasks"
msgstr "A2 — Sich über einfache, alltägliche Aufgaben verständigen"

#: eures_beta/templates/employer/language_strings.html:9
msgctxt "employer languages"
msgid "B1 — Handle familiar situations and explain simple points"
msgstr "B1 — Vertraute Situationen bewältigen und einfache Sachverhalte erklären"

#: eures_beta/templates/employer/language_strings.html:10
msgctxt "employer languages"
msgid "B2 — Communicate with ease and discuss detailed matters"
msgstr "B2 — Sich flüssig austauschen und ausführliche Themen besprechen"

#: eures_beta/templates/employer/language_strings.html:11
msgctxt "employer languages"
msgid "C1 — Communicate fluently and precisely in complex situations"
msgstr "C1 — In komplexen Situationen fließend und präzise kommunizieren"

#: eures_beta/templates/employer/language_strings.html:12
msgctxt "employer languages"
msgid "C2 — Understand almost everything and express fine distinctions"
msgstr "C2 — Fast alles verstehen und feine Bedeutungsunterschiede ausdrücken"

